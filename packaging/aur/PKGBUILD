pkgname=earshot
pkgver=0.1.3
pkgrel=1
pkgdesc='Local speech-to-text library and CLI powered by whisper.cpp'
arch=('x86_64')
url='https://github.com/akemiff/earshot'
license=('MIT')
depends=('gcc-libs' 'glibc')
makedepends=('cmake' 'git')
optdepends=('cuda: GPU acceleration' 'curl: download Whisper models from the CLI')
source=("$pkgname-$pkgver.tar.gz::https://github.com/akemiff/earshot/archive/v$pkgver.tar.gz")
sha256sums=('SKIP')

# CUDA compilation is memory intensive. Override with EARSHOT_BUILD_JOBS=4
# on a machine with enough memory; two jobs are a safer default for AUR users.
: "${EARSHOT_BUILD_JOBS:=2}"
: "${EARSHOT_CUDA_ARCHITECTURES:=native}"

build() {
    cmake -S "$srcdir/$pkgname-$pkgver" -B build \
        -DCMAKE_BUILD_TYPE=Release -DEARSHOT_BUILD_TESTS=OFF \
        -DEARSHOT_BUILD_CLI=ON -DEARSHOT_CUDA=ON \
        -DCMAKE_CUDA_ARCHITECTURES="$EARSHOT_CUDA_ARCHITECTURES" \
        -DCMAKE_INSTALL_PREFIX=/usr
    cmake --build build --parallel "$EARSHOT_BUILD_JOBS"
}

check() {
    cmake -S "$srcdir/$pkgname-$pkgver" -B check-build \
        -DCMAKE_BUILD_TYPE=Release -DEARSHOT_CUDA=OFF -DEARSHOT_BUILD_TESTS=ON
    cmake --build check-build --parallel "$EARSHOT_BUILD_JOBS"
    ctest --test-dir check-build --output-on-failure
}

package() {
    DESTDIR="$pkgdir" cmake --install build
    install -Dm644 "$srcdir/$pkgname-$pkgver/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
